ENVIRONMENT=local
NGINX_PORT=8080
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
ADMIN_BASE_URL=/backend-admin

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/shop
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@db:5432/shop
POSTGRES_ECHO=false

MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=shop_assets

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

BROKER_URL=amqp://guest:guest@rabbitmq/
EVENTS_RABBITMQ_URL=amqp://guest:guest@rabbitmq/
EVENTS_RABBITMQ_EXCHANGE_NAME=shop.events
EVENTS_RABBITMQ_QUEUE_NAME=shop.events.main
EVENTS_RABBITMQ_QUEUE_ROUTING_KEY=shop.#
EVENTS_RABBITMQ_DEAD_LETTER_QUEUE_NAME=shop.events.dlq
EVENTS_RABBITMQ_DEAD_LETTER_ROUTING_KEY=shop.dead

JWT_SECRET=change-me-use-secret-manager
SECRET_KEY=change-me-use-secret-manager
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
HTTPS_REDIRECT_ENABLED=false
SECURITY_HSTS_ENABLED=false
CSRF_ENABLED=true

PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret
DELIVERY_WEBHOOK_SECRET=change-me-delivery-webhook-secret

SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
ADMIN_ALERT_EMAILS=

METRICS_ENABLED=true
METRICS_TOKEN=
LOG_JSON=true
LOG_LEVEL=INFO
SENTRY_DSN=

IMAGE_CDN_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

VITE_API_BASE_URL=/api
VITE_API_MOCKS=false
VITE_REALTIME_URL=

NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
NPM_CONFIG_PROXY=
NPM_CONFIG_HTTPS_PROXY=
NPM_CONFIG_STRICT_SSL=true

PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=
PIP_PROXY=

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
